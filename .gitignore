# Build output — Cloudflare Pages regenerates via build.sh on every deploy
public/

# Regenerated indexes — wiped and rewritten by the index scripts
#   compendium-index.json : scripts/index_compendium.py (called by build.sh)
#   akashic-index.json    : scripts/index_akashic.py  (run separately, NOT by build.sh)
static/compendium-index.json
static/akashic-index.json

# Regenerated by build.sh (generate_api.py rmtree's this dir)
static/api/

# Hugo artifacts
resources/_gen/
.hugo_build.lock

# Test builds
public_test_build/

# Scratch
tmp/

# Local backups — pre-edit copies written by the site scripts (metadata/backups/<date>_<slug>/).
# Local reference only: never committed, never deployed. Mirrors the corpus tree's convention
# without pulling backup weight into the repo.
metadata/

# Unused / generated assets (regenerated by build scripts or unused)
# Measured 2026-10-26, two separate traps here:
# 1) The pattern must be `static/images/*`, NOT `static/images/`. A trailing-slash
#    directory pattern excludes the directory itself, and Git cannot re-include a
#    path whose parent directory is excluded — so every `!` line below was inert
#    for untracked files, and a new image added here is silently ignored: it never
#    reaches the commit, and therefore never reaches the deploy.
# 2) The legacy filenames contain `[1080]` / `[OG ...]`. An unescaped `[` is a glob
#    character class, so those two negations did not match their own filenames even
#    after fix 1. Brackets must be escaped as `\[`.
static/images/*
# Restore only the used images
!static/images/TekTribe Chronicles Logo \[1080\].png
!static/images/Overseer \[OG Transparent\].png
!static/images/ogpreview_awakening-lockup_1200x630.jpg
!static/images/ogpreview_tt-emblem_graded-ground_1200x630.jpg

# Deprecated content — kept locally for reference, not deployed
deprecated/

# Daily audit reports — written into the repo root by the audit cron each run.
# They are already saved by the cron system (`hermes cron runs`), so they are
# generated output here, not source. Use `git add -f` to keep one deliberately.
WEB-AUDIT-*.md

# Python bytecode
__pycache__/
*.pyc
