# Build output — Cloudflare Pages regenerates via build.sh on every deploy
public/

# Regenerated indexes — wiped and rewritten by the index scripts
#   compendium-index.json : scripts/index_compendium.py (called by build.sh)
#   akashic-index.json    : scripts/index_akashic.py  (run separately, NOT by build.sh)
static/compendium-index.json
static/akashic-index.json

# Regenerated by build.sh (generate_api.py rmtree's this dir)
static/api/

# Hugo artifacts
resources/_gen/
.hugo_build.lock

# Test builds
public_test_build/

# Scratch
tmp/

# Local backups — pre-edit copies written by the site scripts (metadata/backups/<date>_<slug>/).
# Local reference only: never committed, never deployed. Mirrors the corpus tree's convention
# without pulling backup weight into the repo.
metadata/

# Unused / generated assets (regenerated by build scripts or unused)
static/images/
# Restore only the used images
!static/images/TekTribe Chronicles Logo [1080].png
!static/images/Overseer [OG Transparent].png

# Deprecated content — kept locally for reference, not deployed
deprecated/

# Python bytecode
__pycache__/
*.pyc
